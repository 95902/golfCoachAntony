            {
              "name": "customerName",
              "value": "={{$json.customer.firstName}} {{$json.customer.lastName}}"
            },
            {
              "name": "customerEmail",
              "value": "={{$json.customer.email}}"
            },
            {
              "name": "bookingId",
              "value": "={{$json.booking.id}}"
            },
            {
              "name": "cancellationReason",
              "value": "={{$json.booking.cancellationReason || 'Non spécifiée'}}"
            },
            {
              "name": "bookingDate",
              "value": "={{$json.booking.bookingDate}}"
            },
            {
              "name": "startTime",
              "value": "={{$json.booking.startTime}}"
            }
          ]
        }
      },
      "id": "set-vars-cancelled",
      "name": "Set Variables Cancelled",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 600]
    },
    {
      "parameters": {
        "operation": "sendEmail",
        "email": "={{$json.customerEmail}}",
        "subject": "❌ Annulation de réservation - Golf Coach Antony",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: #dc2626; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }\n    .content { background: #f9fafb; padding: 20px; border: 1px solid #e5e7eb; }\n    .details { background: white; padding: 15px; margin: 15px 0; border-left: 4px solid #dc2626; border-radius: 4px; }\n    .button { display: inline-block; background: #16a34a; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; margin: 15px 0; }\n    .footer { text-align: center; color: #6b7280; font-size: 12px; margin-top: 20px; padding: 15px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>❌ Annulation de réservation</h1>\n    </div>\n\n    <div class=\"content\">\n      <p>Bonjour <strong>{{$json.customerName}}</strong>,</p>\n\n      <p>Votre réservation <strong>#{{$json.bookingId}}</strong> a bien été annulée.</p>\n\n      <div class=\"details\">\n        <h3 style=\"margin-top: 0; color: #dc2626;\">Réservation annulée</h3>\n        <p><strong>Date :</strong> {{$json.bookingDate}}</p>\n        <p><strong>Horaire :</strong> {{$json.startTime}}</p>\n      </div>\n\n      <p>Nous espérons vous revoir bientôt !</p>\n      \n      <p style=\"text-align: center; margin: 30px 0;\">\n        <a href=\"https://golfcoachantony.com/booking/indoor\" class=\"button\">Nouvelle réservation</a>\n      </p>\n\n      <p>\n        Sportivement,<br>\n        <strong>L'équipe Golf Coach Antony</strong>\n      </p>\n    </div>\n\n    <div class=\"footer\">\n      <p>© 2024 Golf Coach Antony - Tous droits réservés</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
